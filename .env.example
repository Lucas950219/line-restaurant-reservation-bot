LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 選填。每筆訂位使用的用餐時間（分鐘）。
RESERVATION_DURATION_MINUTES=90

# 選填。店家專屬檢視連結的隨機金鑰，及 Pages 來源網域。
DASHBOARD_ACCESS_TOKEN=
DASHBOARD_SITE_ORIGIN=
# 選填。店家管理連結的金鑰，請使用與檢視金鑰不同的隨機值。
DASHBOARD_MANAGEMENT_TOKEN=

# 選填。以下設定用於 bot.py ask 的本機 Codex 測試。
